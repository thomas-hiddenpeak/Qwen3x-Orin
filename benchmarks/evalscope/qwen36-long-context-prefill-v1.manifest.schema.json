{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qwen36-long-context-prefill-v1.manifest.schema.json",
  "title": "Qwen3.6-27B long-context EvalScope performance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "sources",
    "tokenizer",
    "request_contract",
    "buckets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact": {"const": "qwen36_evalscope_long_context_prefill_v1"},
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "tokenizer": {"$ref": "#/$defs/tokenizer"},
    "request_contract": {"$ref": "#/$defs/request_contract"},
    "buckets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p8k", "p16k", "p40k"],
      "properties": {
        "p8k": {
          "allOf": [
            {"$ref": "#/$defs/one_phase_bucket"},
            {"properties": {"token_window": {"const": [7168, 8191]}}}
          ]
        },
        "p16k": {
          "allOf": [
            {"$ref": "#/$defs/one_phase_bucket"},
            {"properties": {"token_window": {"const": [14336, 16383]}}}
          ]
        },
        "p40k": {
          "type": "object",
          "additionalProperties": false,
          "required": ["token_window", "runs"],
          "properties": {
            "token_window": {"const": [39000, 40000]},
            "runs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prefill1", "cold16"],
              "properties": {
                "prefill1": {"$ref": "#/$defs/prefill1_run"},
                "cold16": {"$ref": "#/$defs/cold16_run"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "revision",
        "source_artifact_sha256",
        "license_or_terms",
        "benchmark_authorization",
        "selection"
      ],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "license_or_terms": {"type": "string", "minLength": 1},
        "benchmark_authorization": {"type": "string", "minLength": 1},
        "selection": {
          "const": "complete natural conversation prefixes; no padding, repetition, truncation, concatenation, or synthetic text"
        }
      }
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenizer_json_sha256",
        "tokenizer_config_sha256",
        "chat_template_jinja_sha256",
        "add_generation_prompt",
        "enable_thinking"
      ],
      "properties": {
        "tokenizer_json_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_config_sha256": {"$ref": "#/$defs/sha256"},
        "chat_template_jinja_sha256": {"$ref": "#/$defs/sha256"},
        "add_generation_prompt": {"const": true},
        "enable_thinking": {"const": false}
      }
    },
    "request_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "endpoint",
        "temperature",
        "seed",
        "stream",
        "include_usage",
        "parallel",
        "warmup",
        "measured",
        "prefix_cache",
        "mtp"
      ],
      "properties": {
        "model": {"const": "qwen3.6-27b-nvfp4"},
        "endpoint": {"const": "/v1/completions"},
        "temperature": {"const": 0.0},
        "seed": {"const": 42},
        "stream": {"const": true},
        "include_usage": {"const": true},
        "parallel": {"const": 1},
        "warmup": {"const": 1},
        "measured": {"const": 4},
        "prefix_cache": {"const": false},
        "mtp": {"const": false}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "role",
        "source_id",
        "source_locator",
        "source_record_sha256",
        "prompt_tokens",
        "prompt_sha256",
        "request_sha256"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 4},
        "role": {"enum": ["warmup", "measured"]},
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "source_locator": {"type": "string", "minLength": 1},
        "source_record_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_tokens": {"type": "integer", "minimum": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "run_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "corpus_file",
        "corpus_sha256",
        "count",
        "cases"
      ],
      "properties": {
        "max_tokens": {"enum": [1, 16]},
        "corpus_file": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.jsonl$"
        },
        "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "count": {"const": 5},
        "cases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/case"}
        }
      }
    },
    "prefill1_run": {
      "allOf": [
        {"$ref": "#/$defs/run_base"},
        {"properties": {"max_tokens": {"const": 1}}}
      ]
    },
    "cold16_run": {
      "allOf": [
        {"$ref": "#/$defs/run_base"},
        {"properties": {"max_tokens": {"const": 16}}}
      ]
    },
    "one_phase_bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_window", "runs"],
      "properties": {
        "token_window": {
          "type": "array",
          "prefixItems": [
            {"type": "integer"},
            {"type": "integer"}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "runs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefill1"],
          "properties": {
            "prefill1": {"$ref": "#/$defs/prefill1_run"}
          }
        }
      }
    }
  }
}
