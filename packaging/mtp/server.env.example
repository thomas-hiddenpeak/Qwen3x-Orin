# Use instance cap2 or cap3 and only one GPU service at a time.
# Create the qwen3x account, read-only model access, and a 0400/0600 key first.
# Set an ExecStart drop-in for an installation outside /usr/local.
# Installation never enables or starts this optional service.
Q3X_MODEL_DIR=/absolute/path/to/nvidia/Qwen3.6-27B-NVFP4
Q3X_API_KEY_FILE=/etc/qwen3x-mtp/api-key
Q3X_PORT=8000
