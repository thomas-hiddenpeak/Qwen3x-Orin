{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "orin-release",
      "displayName": "Jetson Orin Release (sm_87)",
      "binaryDir": "${sourceDir}/.q3x-work/build/orin-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "Q3X_CUDA_ARCHITECTURES": "87",
        "Q3X_BUILD_WHOLE_CORE_SERVICE_PRODUCTION": "ON"
      }
    },
    {
      "name": "orin-p40-whole-core-dev",
      "displayName": "Jetson Orin P40 whole-core development baseline",
      "description": "Default-off, accuracy-unqualified v10 P40000 route; not a release or production preset",
      "binaryDir": "${sourceDir}/.q3x-work/build/orin-p40-whole-core-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "Q3X_CUDA_ARCHITECTURES": "87",
        "Q3X_BUILD_P40_WHOLE_CORE_DEVELOPMENT_ROUTE": "ON",
        "Q3X_BUILD_WHOLE_CORE_SERVICE_PRODUCTION": "OFF"
      }
    },
    {
      "name": "orin-p40-whole-core-prod",
      "displayName": "Historical fixed P40 profile (qualification withdrawn)",
      "description": "Retained reproduction only; numerical qualification withdrawn; fixed P40000/O16",
      "binaryDir": "${sourceDir}/.q3x-work/build/orin-p40-whole-core-prod",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "Q3X_CUDA_ARCHITECTURES": "87",
        "Q3X_BUILD_P40_WHOLE_CORE_PRODUCTION_ROUTE": "ON",
        "Q3X_BUILD_WHOLE_CORE_SERVICE_PRODUCTION": "OFF"
      }
    },
    {
      "name": "orin-whole-core-exact-decode-admission",
      "displayName": "Whole-core plus exact Decode integration admission",
      "description": "Non-installable, unqualified composition; not a default-route replacement",
      "binaryDir": "${sourceDir}/.q3x-work/build/orin-whole-core-exact-decode-admission",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "Q3X_CUDA_ARCHITECTURES": "87",
        "Q3X_BUILD_WHOLE_CORE_EXACT_DECODE_ADMISSION": "ON",
        "Q3X_BUILD_WHOLE_CORE_SERVICE_PRODUCTION": "OFF"
      }
    },
    {
      "name": "orin-host-tests",
      "binaryDir": "${sourceDir}/.q3x-work/build/orin-host-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "Q3X_BUILD_WHOLE_CORE_SERVICE_PRODUCTION": "OFF",
        "Q3X_CUDA_ARCHITECTURES": "87"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "orin-release",
      "configurePreset": "orin-release"
    },
    {
      "name": "orin-p40-whole-core-dev",
      "configurePreset": "orin-p40-whole-core-dev",
      "targets": [
        "qwen3x-eval-server"
      ]
    },
    {
      "name": "orin-p40-whole-core-prod",
      "configurePreset": "orin-p40-whole-core-prod",
      "targets": [
        "qwen3x-eval-server"
      ]
    },
    {
      "name": "orin-whole-core-exact-decode-admission",
      "configurePreset": "orin-whole-core-exact-decode-admission",
      "targets": [
        "qwen3x-eval-server"
      ]
    },
    {
      "name": "orin-host-tests",
      "configurePreset": "orin-host-tests"
    }
  ],
  "testPresets": [
    {
      "name": "orin-release",
      "configurePreset": "orin-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "orin-host-tests",
      "configurePreset": "orin-host-tests",
      "filter": {
        "include": {
          "label": "host"
        }
      },
      "execution": {
        "noTestsAction": "error"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
