    {
      "id": "projection_sql",
      "label": "NVFP4 projection summary",
      "path": "docs/analysis/qwen36-27b-nvfp4-zero-stats-2026-07-29/report_source.sqlite",
      "query": {
        "engine": "sqlite",
        "language": "sql",
        "sql": "SELECT scope AS projection, blocks, zero_values, zero_rate,\n       blocks_with_any_zero, any_zero_rate, all_zero_blocks\nFROM zero_summary\nWHERE scope_type = 'projection'\nORDER BY CASE scope\n    WHEN 'gate' THEN 1 WHEN 'up' THEN 2 WHEN 'down' THEN 3 ELSE 4 END",
        "description": "Returns exact zero statistics for gate, up, down, and lm_head projections.",
        "executed_at": "2026-07-28T18:54:36.218616+00:00",
        "tables_used": [
