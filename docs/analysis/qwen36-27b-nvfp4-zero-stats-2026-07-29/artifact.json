    {
      "id": "layer_sql",
      "label": "NVFP4 Transformer-layer summary",
      "path": "docs/analysis/qwen36-27b-nvfp4-zero-stats-2026-07-29/report_source.sqlite",
      "query": {
        "engine": "sqlite",
        "language": "sql",
        "sql": "SELECT scope AS layer, blocks, zero_values, zero_rate,\n       blocks_with_any_zero, any_zero_rate, all_zero_blocks\nFROM zero_summary\nWHERE scope_type = 'layer' AND scope LIKE 'layer_%'\nORDER BY zero_rate DESC",
