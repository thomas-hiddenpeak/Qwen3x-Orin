diff --git a/src/kernels/sm87/publication_epilogue_admission.h b/src/kernels/sm87/publication_epilogue_admission.h
new file mode 100644
index 0000000..94db830
--- /dev/null
+++ b/src/kernels/sm87/publication_epilogue_admission.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "cutlass/epilogue/thread/linear_combination.h"
+#include <cuda_bf16.h>
+namespace q3x::kernels {
+// The base no-source operator preserves the incumbent scale multiply and BF16
+// publication. Source is an already-rounded Gate or residual, never beta*C.
+template<bool Silu> struct PublicationEpilogue :
+    cutlass::epilogue::thread::LinearCombination<cutlass::bfloat16_t,8,float,float> {
+  using Base = cutlass::epilogue::thread::LinearCombination<cutlass::bfloat16_t,8,float,float>;
+  using typename Base::FragmentOutput;
+  using typename Base::FragmentAccumulator;
+  using typename Base::FragmentSource;
+  using typename Base::Params;
+  CUTLASS_HOST_DEVICE PublicationEpilogue(Params const& p): Base(p) {}
+  CUTLASS_HOST_DEVICE bool is_source_needed() const { return true; }
+  CUTLASS_HOST_DEVICE void set_k_partition(int, int) {} // split-K is fixed to 1
+  CUTLASS_HOST_DEVICE FragmentOutput operator()(FragmentAccumulator const& acc,
+                                               FragmentSource const& src) const {
+    FragmentOutput rounded = Base::operator()(acc), out;
+    CUTLASS_PRAGMA_UNROLL
+    for (int i=0; i<8; ++i) {
+      float x=float(src[i]), y=float(rounded[i]);
+      float z;
+      if constexpr(Silu) { float s=x/(1.0f+expf(-x)); z=s*y; }
+      else { z=x+y; }
+      out[i]=cutlass::bfloat16_t(z);
+    }
+    return out;
+  }
+  CUTLASS_HOST_DEVICE FragmentOutput operator()(FragmentAccumulator const& acc) const {
+    return Base::operator()(acc);
+  }
+};
+}
