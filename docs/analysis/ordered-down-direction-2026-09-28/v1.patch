diff --git a/src/kernels/sm87/nvfp4_down_ordered_admission.cu b/src/kernels/sm87/nvfp4_down_ordered_admission.cu
new file mode 100644
--- /dev/null
+++ b/src/kernels/sm87/nvfp4_down_ordered_admission.cu
@@ -0,0 +1,71 @@
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <cstddef>
+#include <initializer_list>
+#include "cutlass/cutlass.h"
+#include "cutlass/gemm/device/gemm.h"
+#include "cutlass/epilogue/thread/linear_combination.h"
+#include "nvfp4_down_ordered_admission.h"
+
+namespace q3x::kernels {
+namespace {
+constexpr int N=5120,K=17408,Panel=8000;
+__device__ int original_k(int k) {return (k%(K/2)/32)*64+(k/(K/2))*32+k%32;}
+__global__ void decode_ordered_b(const uint8_t* packed,const uint8_t* scales,uint16_t* b) {
+ int i=blockIdx.x*blockDim.x+threadIdx.x;if(i>=N*K)return;
+ int n=i/K, k=original_k(i%K),n64=n%64;
+ int perm=(n64%8)*8+n64/8;
+ int sn=(n/64)*64+(perm&~3)+((perm&1)<<1)+((perm&2)>>1);
+ unsigned sc=scales[(k/16)*N+sn];
+ unsigned nib=(packed[(n*K+k)/2]>>((k%2)*4))&15;
+ auto x=__ushort_as_bfloat16(((nib&8)<<12)|((nib&7)<<6));
+ auto s=__ushort_as_bfloat16(((sc&128)<<7)|((sc&127)<<4));
+ b[i]=__bfloat16_as_ushort(__hmul(x,s));
+}
+__global__ void permute_a(const uint16_t* a,uint16_t* dst,int m) {
+ int i=blockIdx.x*blockDim.x+threadIdx.x;if(i<m*K)dst[i]=a[(i/K)*K+original_k(i%K)];
+}
+__global__ void merge_residual(const float* c0,const float* c1,const float* scale,uint16_t* out,int m) {
+ int i=blockIdx.x*blockDim.x+threadIdx.x;if(i>=m*N)return;
+ float v=__fmul_rn(__fadd_rn(c0[i],c1[i]),scale[0]);
+ float branch=__bfloat162float(__float2bfloat16_rn(v));
+ out[i]=__bfloat16_as_ushort(__float2bfloat16_rn(__fadd_rn(branch,__bfloat162float(__ushort_as_bfloat16(out[i])))));
+}
+using Gemm=cutlass::gemm::device::Gemm<cutlass::bfloat16_t,cutlass::layout::RowMajor,
+ cutlass::bfloat16_t,cutlass::layout::ColumnMajor,float,cutlass::layout::RowMajor,
+ float,cutlass::arch::OpClassTensorOp,cutlass::arch::Sm80,
+ cutlass::gemm::GemmShape<128,256,64>,cutlass::gemm::GemmShape<64,64,64>,
+ cutlass::gemm::GemmShape<16,8,16>,cutlass::epilogue::thread::LinearCombination<float,4,float,float>,
+ cutlass::gemm::threadblock::GemmIdentityThreadblockSwizzle<2>,3>;
+}
+static size_t required_scratch_bytes(){return size_t(N)*K*2+size_t(Panel)*K*2+size_t(Panel)*N*8;}
+int launch_nvfp4_down_ordered_admission(const uint8_t* packed,const uint8_t* scales,const float* global,
+ const uint16_t* input,uint16_t* residual,int rows,void* scratch,size_t bytes,void* stream0) {
+ if(!packed||!scales||!global||!input||!residual||!scratch||rows<1||rows>44096||rows%64||bytes<required_scratch_bytes())return 1;
+ for(const void* p : {static_cast<const void*>(packed),static_cast<const void*>(scales),static_cast<const void*>(input),static_cast<const void*>(residual),static_cast<const void*>(scratch)})
+  if(reinterpret_cast<uintptr_t>(p)%16)return int(cudaErrorInvalidValue);
+ const uintptr_t sb=reinterpret_cast<uintptr_t>(scratch),se=sb+required_scratch_bytes();
+ if(se<sb||reinterpret_cast<uintptr_t>(global)%alignof(float))return int(cudaErrorInvalidValue);
+ const auto overlaps=[&](const void* p,size_t n){uintptr_t x=reinterpret_cast<uintptr_t>(p);return x+n<x||(x<se&&sb<x+n);};
+ if(overlaps(packed,size_t(N)*K/2)||overlaps(scales,size_t(N)*K/16)||overlaps(global,4)||overlaps(input,size_t(rows)*K*2)||overlaps(residual,size_t(rows)*N*2))return int(cudaErrorInvalidValue);
+ auto stream=static_cast<cudaStream_t>(stream0);
+ auto b=static_cast<uint16_t*>(scratch);auto a=b+N*K;
+ auto c0=reinterpret_cast<float*>(a+Panel*K);auto c1=c0+Panel*N;
+ decode_ordered_b<<<(N*K+255)/256,256,0,stream>>>(packed,scales,b);
+ for(int start=0;start<rows;start+=Panel){int m=rows-start<Panel?rows-start:Panel;
+  permute_a<<<(m*K+255)/256,256,0,stream>>>(input+size_t(start)*K,a,m);
+  for(int part=0;part<2;part++) {
+   auto c=part?c1:c0;
+   Gemm::Arguments args({m,N,K/2},{reinterpret_cast<cutlass::bfloat16_t*>(a)+part*(K/2),K},
+    {reinterpret_cast<cutlass::bfloat16_t*>(b)+part*(K/2),K},{c,N},{c,N},{1.f,0.f});
+   Gemm gemm;
+   if(Gemm::get_workspace_size(args)||gemm.can_implement(args)!=cutlass::Status::kSuccess)return 2;
+   if(gemm.initialize(args,nullptr,stream)!=cutlass::Status::kSuccess||gemm(stream)!=cutlass::Status::kSuccess)return 3;
+  }
+  merge_residual<<<(m*N+255)/256,256,0,stream>>>(c0,c1,global,residual+size_t(start)*N,m);
+ }
+ return int(cudaGetLastError());
+}
+
+} // namespace q3x::kernels
