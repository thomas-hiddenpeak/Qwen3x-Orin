--- /dev/null
+++ b/src/kernels/sm87/nvfp4_down_ordered_admission.h
@@ -0,0 +1,11 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+namespace q3x::kernels {
+// Isolated admission only. No request allocation; preserves transformed Marlin
+// operands, ordered K32 partitions, FP32 merge and BF16-before-residual boundary.
+int launch_nvfp4_down_ordered_admission(const std::uint8_t* packed,
+    const std::uint8_t* marlin_scales, const float* marlin_global_scale,
+    const std::uint16_t* input, std::uint16_t* residual, int rows,
+    void* scratch, std::size_t scratch_bytes, void* stream);
+}
